# Template for scripts/.env.<environment> (e.g. scripts/.env.dev, scripts/.env.staging).
#
#   cp scripts/.env.example scripts/.env.dev
#   $EDITOR scripts/.env.dev   # fill in the REPLACE-ME values below
#   ./scripts/bootstrap-env.sh dev
#
# scripts/.env.<environment> is gitignored (matches .env.* in .gitignore) — this .example file is
# the only one of these actually committed. bootstrap-env.sh auto-loads scripts/.env.<environment>
# if it exists; nothing needs to be `source`d by hand. See docs/deployment.md for the full
# walkthrough and docs/operator-setup.md for AWS/GitHub authentication.
#
# Not included here: AWS_PROFILE. Which AWS credentials to use is a per-operator, per-terminal
# choice (SSO profile name, IAM user, etc.) rather than project data, so set it yourself before
# running the script, e.g.: export AWS_PROFILE=my-dev-sso-profile

# --- GitHub + AWS region (required) ---

# owner/repo — where the GitHub OIDC trust and GitHub Environment get created.
export GITHUB_REPO="REPLACE-ME"

# AWS region for the state bucket, KMS key, and everything provisioned in environments/<env>.
export AWS_REGION="REPLACE-ME"

# --- Mandatory tags (required) — applied to every resource this repo creates, see
# global/tagging-policy.tf ---

export COST_CENTER="REPLACE-ME"
export DATA_CLASSIFICATION="REPLACE-ME"
export OWNER="REPLACE-ME"
export RETENTION_POLICY="REPLACE-ME"

# --- Networking (required): one non-overlapping CIDR per boundary account, see ADR-0004 ---
# Real, non-overlapping CIDRs — never the RFC 5737 placeholders from terraform.tfvars.example in
# a real apply. Each *_PRIVATE_SUBNET_CIDRS is a JSON list, one subnet per AZ.

export NETWORK_SHARED_VPC_CIDR="REPLACE-ME"
export NETWORK_SHARED_PRIVATE_SUBNET_CIDRS='REPLACE-ME'
export INTEGRATION_VPC_CIDR="REPLACE-ME"
export INTEGRATION_PRIVATE_SUBNET_CIDRS='REPLACE-ME'
export NRT_PROCESSING_VPC_CIDR="REPLACE-ME"
export NRT_PROCESSING_PRIVATE_SUBNET_CIDRS='REPLACE-ME'
export DATA_VPC_CIDR="REPLACE-ME"
export DATA_PRIVATE_SUBNET_CIDRS='REPLACE-ME'

# --- KMS key administrator trust (required) — see ADR-0013 ---
# IAM principal ARN(s) (JSON list) trusted to assume the KMS key administrator role bootstrap/
# creates. CRITICAL: that role can rotate, rewrite the policy of, and schedule/cancel deletion
# of every CMK this platform creates — treat it like a break-glass credential. Never invent a
# value here. In dev/PoC this is typically your own privileged role; in staging/prod this MUST
# be the organization's actual security/governance-team identity, not a developer's own role — see
# docs/deployment.md's KMS admin role section.
export KMS_ADMIN_TRUSTED_PRINCIPAL_ARNS='REPLACE-ME'

# --- Optional: deploy approval gate ---
# Comma-separated GitHub usernames required to approve deploys to this environment. Leave
# commented out for a reviewer-free environment — typically dev, and required if your GitHub
# plan/repo visibility doesn't support environment protection rules (private repo, no Pro/Team/
# Enterprise plan — see docs/operator-setup.md's Troubleshooting section).
# export REQUIRED_REVIEWERS="alice,bob"

# --- Optional: lakehouse / Flink JAR buckets ---
# Leave both commented out and bootstrap-env.sh proposes/creates them for you interactively (see
# docs/deployment.md steps 5-6: a default globally-unique bucket name for the lakehouse, and a
# choice between a real Flink JAR you already have or a placeholder no-op one). Uncomment and
# fill in only if you want to skip those prompts.
# export LAKEHOUSE_BUCKET_NAME="org-nrt-platform-dev-ods"
# export FLINK_APPLICATION_JAR_S3_BUCKET_ARN="arn:aws:s3:::org-nrt-platform-dev-flink-jobs"

# --- Optional: MSK/Flink/Redis/lakehouse sizing ---
# Each defaults to the same value already in variables.tf if left commented out; uncomment to
# override for this environment (e.g. smaller instances for dev, real sizing for prod).
# export MSK_KAFKA_VERSION="3.9.x"
# export MSK_NUMBER_OF_BROKER_NODES="3"
# export MSK_BROKER_INSTANCE_TYPE="kafka.m5.large"
# export MSK_BROKER_EBS_VOLUME_SIZE="100"
# export FLINK_APPLICATION_JAR_S3_KEY="flink-jobs/bootstrap-noop.jar"
# export FLINK_PARALLELISM="2"
# export REDIS_NODE_TYPE="cache.r7g.large"
# export REDIS_NUM_CACHE_CLUSTERS="2"
# export ODS_RETENTION_DAYS="7"
# export ENABLE_DECISIONING_IN_PLATFORM="false"
# export SES_DOMAIN=""   # leave empty until a real sending domain is confirmed
