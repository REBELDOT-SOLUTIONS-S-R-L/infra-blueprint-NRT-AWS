# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Real backend configs (account-specific bucket/KMS key names, generated by bootstrap/'s
# outputs — see docs/deployment.md). Commit only the backend.hcl.example templates.
backend.hcl
backend-*.hcl

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Saved plan files (terraform plan -out=...) can contain the same sensitive values as
# state — never commit them. bootstrap-env.sh's plan-confirm-apply step writes these
# under bootstrap/ and deletes them right after apply, but ignore the pattern regardless.
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Claude/Anthropic API interaction files
# Environment variables and secrets
.env
.env.*
!.env.example

# API configuration and credentials
config.json
config.yaml
config.yml
secrets.json
secrets.yaml
secrets.yml

# Claude cache and conversation files
.claude/
claude_cache/
*.claude_cache
CLAUDE*

# API logs and debug files
claude.log
api_logs/

# Python-specific (if using Claude SDK)
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node.js specific
node_modules/
.npm
package-lock.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.pre-commit*